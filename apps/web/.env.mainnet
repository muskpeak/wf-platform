# ==========================================
# 1. 基础应用配置 (Base App Config)
# ==========================================
NODE_ENV="development"
NEXT_API_BASE_URL="http://localhost:3000"
APP_NAME="WF"
APP_URL="http://localhost:3000"

# 当前项目运行的主要链 ID (137 是 Polygon 主网)
CHAIN_ID=137

# 各链节点地址 (RPC)
CHAIN_RPC_URL="https://polygon-rpc.com"

# 合约地址
USDC_ADDRESS="0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359"    # Polygon Mainnet Native USDC
NEXT_PUBLIC_USDC_ADDRESS="0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359"
USDC_SYMBOL="USDC"
USDC_DECIMALS=6
    
# ==========================================
# 2. Web3 基础设施 (Web3 Infrastructure)
# ==========================================
# 这些变量会在启动时下发给浏览器前端 (Client Config)
PRIVY_APP_ID="cmto4oyay00aq0dkv5ea7ktcq"
ZERODEV_PROJECT_ID="5119316e-7dfb-4d74-8f44-811e283c5e70"
ZERODEV_RPC_HOST="https://rpc.zerodev.app/api/v3"
ALCHEMY_API_KEY="your_alchemy_api_key"
WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"

# ==========================================
# 3. 后端私密配置 (Server Secrets)
# ==========================================
# 这些变量永远留在服务端，绝不会被传递给浏览器
SESSION_SECRET="super_secret_session_key"
DATABASE_URL="postgresql://user:password@localhost:5432/db"
